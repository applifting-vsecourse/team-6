// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?   @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  role            UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)
  profile         Profile?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

enum MeetingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY

  @@map("meeting_frequency")
}

enum TagKind {
  TEACH
  LEARN
  INTEREST

  @@map("tag_kind")
}

model City {
  id       String    @id @default(cuid())
  name     String
  lat      Float
  lng      Float
  profiles Profile[]

  @@map("city")
}

model Tag {
  id        String       @id @default(cuid())
  slug      String       @unique
  createdAt DateTime     @default(now()) @map("created_at")
  profiles  ProfileTag[]

  @@map("tag")
}

model ProfileTag {
  userId  String  @map("user_id")
  tagId   String  @map("tag_id")
  kind    TagKind
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId, kind])
  @@map("profile_tag")
}

model Profile {
  userId                String            @id @map("user_id")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position              String?
  roles                 String[]          @default([])
  latitude              Float?            @map("latitude")
  longitude             Float?            @map("longitude")
  expectations          String?
  meetingFrequency      MeetingFrequency? @map("meeting_frequency")
  weekdays              Boolean           @default(false)
  weekends              Boolean           @default(false)
  mornings              Boolean           @default(false)
  afternoons            Boolean           @default(false)
  evenings              Boolean           @default(false)
  cityId                String?           @map("city_id")
  city                  City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  radiusKm              Int?              @map("radius_km")
  note                  String?           @db.Text
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  tags                  ProfileTag[]

  @@map("profile")
}
